# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=put-your-discord-bot-token-here 

# Optional GitHub token. Recommended for public repos and required for private repos.
GITHUB_TOKEN=

# Bot checks GitHub for new commits every N seconds.
POLL_INTERVAL_SECONDS=60
POLL_POST_ON_STARTUP=false
STATE_FILE=.githubwatcher-state.json
ROUTES_FILE=

# Optional fallback target when a repo is not listed in GITHUBWATCHER_ROUTES.
# Use either DEFAULT_THREAD_ID or DEFAULT_CHANNEL_ID.
DEFAULT_CHANNEL_ID=
DEFAULT_THREAD_ID=

# Route each GitHub repo to a Discord channel or thread.
# Keys are "owner/repo" in lowercase-insensitive form.
# For a normal Discord channel:
# GITHUBWATCHER_ROUTES={"richiesdevhub/githubwatcher":{"channel_id":"123456789012345678","branch":"main"}}
#
# For a Discord thread/forum post:
# GITHUBWATCHER_ROUTES={"richiesdevhub/githubwatcher":{"thread_id":"123456789012345678","branch":"main"}}
GITHUBWATCHER_ROUTES={"owner/repo":{"thread_id":"123456789012345678","branch":"main"}}
